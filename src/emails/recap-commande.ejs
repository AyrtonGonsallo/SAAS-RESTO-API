<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <title><%= titre %></title>
    <style>
        .center{text-align: center;}
        .desc p{margin-top: 0px; margin-bottom: 0px;}
        body {
            font-family: "Montserrat";
            background-color: #F4F4F4;
            margin: 0;
            padding: 0;
        }
        .content{font-size: 15px;}
        .body-cnt{
            padding-top: 20px;
            padding-bottom: 20px;
            background: #F4F4F4;
            width: 100%;
        }
        .container {
            width: 60%;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 0px;
            padding: 15px 36px;
            overflow: hidden;
        }
        .header {
            position: relative;
            width:auto;
            height:100%;
            font-family: 'Sarpanch-Regular' !important;
            align-items: center !important;
            padding: 20px;
            text-align: center !important;
            max-width: 100%;
            margin: auto;
        }
        .footer a {
            color: #43B9B2;
            text-decoration: underline;
        }
        .footer a:hover {
            color: #555555;
        }
        .form-btn{
            background-color: #43b9b2;
            color: #ffffff !important;
            text-decoration: none;
            border-radius: 9px;
            padding: 9px 12px;
            border: none;
            text-align: center;
        }
        .div-center{
            display: flex;
            justify-content: center;
        }
        
    </style>
</head>
<body>
<div class="body-cnt">
    <div class="container">
        <!-- Header -->
        <div class="header">
            <div>
                
                <div class="center">
                  <!--
                  <img src="http://resto.orocom.io/images/logo_app_500.png" alt="Logo du site">  
                  -->
                
  
                </div>
        </div>       
        </div>
     

        <!-- Main Content -->
        <div class="content">
            
          <%- body_haut %>

          <table style="width:100%; border-collapse: collapse; font-family: Arial;">
            
            <!-- HEADER -->
            <thead>
              <tr style="background:#f2f2f2;">
                <th align="left" style="padding:10px;">Produit</th>
                <th align="left" style="padding:10px;">Variations</th>
                <th align="left" style="padding:10px;">Quantité</th>
                <th align="left" style="padding:10px;">Prix unitaire TTC</th>
                <th align="left" style="padding:10px;">Prix TTC</th>
              </tr>
            </thead>

            <!-- BODY -->
            <tbody>
              <% produits.forEach(p => { %>
                <tr>
                  <td style="padding:10px; border-bottom:1px solid #ddd;">
                    <%= p.titre %>
                  </td>

                  <td style="padding:10px; border-bottom:1px solid #ddd;">
                    <%= p.variations %>
                  </td>

                  <td style="padding:10px; border-bottom:1px solid #ddd;">
                    <%= p.quantite %>
                  </td>

                  <td style="padding:10px; border-bottom:1px solid #ddd;">
                    <%= p.prix_ht %> €
                  </td>

                  <td style="padding:10px; border-bottom:1px solid #ddd;">
                    <%= p.prix_ht * p.quantite %> €
                  </td>
                </tr>
              <% }) %>

          
              
              <!-- TOTAL -->
              <tr style="background: #f2f2f23d;border-bottom: 1px solid #ddd;">
                <td colspan="3" style="padding:12px; font-weight:bold; text-align:right;">

                </td>

                <td colspan="2" style="padding:10px; font-weight:bold;">

                  Total <%= prix_total %> € TTC<br> Dont TVA (<%= tvaRate %> %) = <%= total_tva %> €
                </td>
              </tr>
            </tbody>
          </table>

          <%- body_bas %>


        </div>
        

        <!-- Footer -->
  <div class="footer">
    <div style="border:1px solid #E6E6E6 ;"></div>
        <%- footer_haut %>

      <div style="border:1px solid #E6E6E6 ;"></div>

        <%- footer_bas %>

        
      </div>
    </div>
  </div>
</body>
</html>
